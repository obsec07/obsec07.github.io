---
import { SITE, CATEGORY_LABELS, STATIC_SITE, avatarUrl, profileAttrs, profileUrl } from '../config';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const avatar = (base + '/avatar.svg').replace(/\/{2,}/g, '/');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-col">
        <h4>Online statistics</h4>
        <ul class="foot-stats">
          <li><span>Members online:</span><span>1</span></li>
          <li><span>Guests online:</span><span>0</span></li>
          <li><span>Total visitors:</span><span>1</span></li>
        </ul>
        <div class="box">Totals may include hidden visitors.</div>
      </div>

      <div class="foot-col">
        <h4>Latest posts</h4>
        <ul class="foot-posts">
          {posts.map((p) => (
            <li>
              <img class="av" src={avatarUrl(SITE.handle)} {...profileAttrs(SITE.handle)} alt="" width="34" height="34" loading="lazy" />
              <div>
                <a href={href('/posts/' + p.id)}>{p.data.title}</a>
                <div class="m">Latest: {SITE.handle} · {fmt(p.data.date)}</div>
                <div class="m"><a class="cat-link" href={href('/' + p.data.category)}>{CATEGORY_LABELS[p.data.category] ?? p.data.category}</a></div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="foot-col foot-members">
        <h4>Newest members</h4>
        <div class="foot-member-list">
          {STATIC_SITE
            ? <a class="foot-member" href={profileUrl(SITE.handle)}><img src={avatarUrl(SITE.handle)} {...profileAttrs(SITE.handle)} alt={SITE.handle} width="40" height="40" /></a>
            : <Fragment set:html={'<!--MEMBERS_SLOT-->'} />}
        </div>
      </div>

      <div class="foot-col foot-social">
        <h4>Stay connected</h4>
        <a class="foot-gh" href={SITE.socials.github} aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
        </a>
        <a class="foot-medium" href={SITE.socials.medium} aria-label="Medium" title="Medium" target="_blank" rel="me noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M6.9 6.5a6.1 6.1 0 1 0 0 11.1 6.1 6.1 0 0 0 0-11.1Zm8.6.3c-1.5 0-2.7 2.4-2.7 5.3s1.2 5.3 2.7 5.3 2.7-2.4 2.7-5.3-1.2-5.3-2.7-5.3Zm4.8.5c-.6 0-1 2.1-1 4.8s.4 4.8 1 4.8 1-2.1 1-4.8-.4-4.8-1-4.8Z"/></svg>
        </a>
        <a class="foot-ig" href={SITE.socials.instagram} aria-label="Instagram" title="Instagram" target="_blank" rel="me noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        </a>
        <a class="foot-mail" href={`mailto:${SITE.email}`} aria-label="Email" title={SITE.email}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="foot-bottom">
    <div class="wrap">
      <a href={`mailto:${SITE.email}`}>Contact us</a>
      <a href={href('/whoami')}>Who am I</a>
      <a href={href('/')}>Home</a>
      <a class="foot-rss" href={href('/rss.xml')} title="RSS" aria-label="RSS feed">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#f26522"/><circle cx="7" cy="17" r="2" fill="#fff"/><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>
      </a>
    </div>
  </div>
</footer>
