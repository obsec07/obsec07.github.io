---
import { SITE, NAV, STATIC_SITE, avatarUrl } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// current tab, XenForo-style like the reference: the forum list, categories and threads are "Forums";
// new posts + search are "What's new"
const rel = path.slice(base.length) || '/';
const tab = /^\/(whats-new|search)(\/|$)/.test(rel) ? "What's new" : /^\/(whoami|account|members|admin)(\/|$)/.test(rel) ? '' : 'Forums';
const a = SITE.handle.slice(0, Math.ceil(SITE.handle.length / 2));
const b = SITE.handle.slice(Math.ceil(SITE.handle.length / 2));
const loginHref = href('/login');
const registerHref = href('/register');
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href={href('/')} aria-label={SITE.handle}>
      <svg class="mask-logo" viewBox="0 0 38 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="mkg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#d4d7db"/>
            <stop offset=".5" stop-color="#9298a3"/>
            <stop offset="1" stop-color="#565b66"/>
          </linearGradient>
        </defs>
        <!-- mask body (teardrop, curl at top) -->
        <path d="M24 2 C31 4 35 11 35 20 C35 32 29 43 19 47 C10 43 3 33 3 21 C3 12 8 5 16 3 C18 2.4 21 1.6 24 2 Z"
              fill="url(#mkg)" stroke="#22262b" stroke-width="1.6" stroke-linejoin="round"/>
        <!-- top curl -->
        <path d="M24 2 C19 4 17 9 19 14 C22 10 28 9 33 12 C32 7 29 3.5 24 2 Z" fill="#3b3f46"/>
        <!-- eye hole -->
        <circle cx="14" cy="17" r="3.4" fill="#17191d" stroke="#0e1013" stroke-width="1"/>
        <!-- magatama comma cutout -->
        <path d="M28 20 C32 20 34 24 32 28 C31 31 27 31 26 28 C25 25 25 21 28 20 Z" fill="#faf6f1"/>
        <!-- bands -->
        <path d="M6 31 C13 34 25 34 33 30" fill="none" stroke="#22262b" stroke-width="1.5"/>
        <path d="M7 39 C13 42 24 42 31 38" fill="none" stroke="#22262b" stroke-width="1.5"/>
        <!-- wood grain -->
        <path d="M11 8 C9 20 10 33 13 44" fill="none" stroke="#5f636b" stroke-width=".7" opacity=".7"/>
        <path d="M19 5 C17 20 18 34 19 45" fill="none" stroke="#5f636b" stroke-width=".7" opacity=".6"/>
      </svg>
      <span class="word"><span class="a">{a}</span><span class="b">{b}</span></span>
    </a>

    <nav class="nav">
      {NAV.map((n) => {
        const active = n.label === tab;
        return (
          <div class="nav-item">
            <a href={href(n.href)} class={active ? 'active' : ''}>{n.label}{n.caret && <span class="caret">▾</span>}</a>
            {n.menu && <div class="dropdown">{n.menu.map((m) => <a href={href(m.href)}>{m.label}</a>)}</div>}
          </div>
        );
      })}

      <div class="h-icons">
        {STATIC_SITE ? (
          // no accounts on the static site: "log in" is the /admin post editor. Signed in there (the session lives in
          // this browser's storage), the header shows the owner's avatar -> /admin and a log-out button instead.
          <Fragment>
            <a class="h-icon" id="h-login" href={href('/admin/')} title="Log in" aria-label="log in">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            </a>
            <a class="h-icon h-avatar" id="h-admin" href={href('/admin/')} title="Admin panel" aria-label="admin panel" hidden>
              <img src={avatarUrl(SITE.handle)} alt="" width="24" height="24" />
            </a>
            <button class="h-icon" id="h-logout" type="button" title="Log out" aria-label="log out" hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </button>
            <script is:inline>
              (function () {
                var login = document.getElementById('h-login'), admin = document.getElementById('h-admin'), out = document.getElementById('h-logout');
                function signedIn() { try { return !!(sessionStorage.getItem('adm') || localStorage.getItem('adm')); } catch (e) { return false; } }
                function sync() { var on = signedIn(); login.hidden = on; admin.hidden = !on; out.hidden = !on; }
                sync();
                out.addEventListener('click', function () {
                  try { sessionStorage.removeItem('adm'); localStorage.removeItem('adm'); } catch (e) {}
                  sync();
                  document.dispatchEvent(new Event('adm:signout')); // /admin swaps back to its login form
                });
                document.addEventListener('adm:session', sync);   // /admin signed in or out
                window.addEventListener('storage', function (e) { if (!e.key || e.key === 'adm') sync(); }); // other tabs
                window.addEventListener('pageshow', sync);        // back/forward cache
              })();
            </script>
          </Fragment>
        ) : <Fragment set:html={'<!--ICONS_SLOT-->'} />}
        <a class="h-icon" href={href('/search')} title="Search" aria-label="search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
      </div>
    </nav>
  </div>
</header>
<div class="subnav">
  <div class="wrap">
    <a href={href('/whats-new')}>New posts</a>
    <a href={href('/search')}>Search forums</a>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
      <span class="for-light"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
      <span class="for-dark"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
      <span class="for-light">Dark</span><span class="for-dark">Light</span>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle'), root = document.documentElement;
        function set(t) {
          root.setAttribute('data-theme', t);
          var m = document.querySelector('meta[name=theme-color]'); if (m) m.content = t === 'dark' ? '#0f131c' : '#faf6f1';
          var c = document.querySelector('meta[name=color-scheme]'); if (c) c.content = t;
          var next = t === 'dark' ? 'light' : 'dark';
          btn.setAttribute('aria-label', 'Switch to ' + next + ' mode'); btn.title = 'Switch to ' + next + ' mode';
          btn.setAttribute('aria-pressed', String(t === 'dark'));
        }
        set(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
        btn.addEventListener('click', function () {
          var t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', t); } catch (e) {}
          var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (document.startViewTransition && !still) document.startViewTransition(function () { set(t); }); else set(t);
        });
        // another tab switched
        window.addEventListener('storage', function (e) { if (e.key === 'theme' && (e.newValue === 'light' || e.newValue === 'dark')) set(e.newValue); });
      })();
    </script>
  </div>
</div>
