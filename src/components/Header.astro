---
import { SITE, NAV } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const a = SITE.handle.slice(0, Math.ceil(SITE.handle.length / 2));
const b = SITE.handle.slice(Math.ceil(SITE.handle.length / 2));
const loginHref = href('/login');
const registerHref = href('/register');
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href={href('/')} aria-label={SITE.handle}>
      <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 13a10 10 0 1 1 20 0v6a3 3 0 0 1-3 3h-1v3h-3v-3h-2v3h-3v-3H9a3 3 0 0 1-3-3v-6Z" fill="#22c7d6"/>
        <circle cx="12" cy="14" r="3" fill="#12203a"/>
        <circle cx="20" cy="14" r="3" fill="#12203a"/>
        <rect x="14.5" y="18" width="3" height="4" fill="#12203a"/>
      </svg>
      <span class="word"><span class="a">{a}</span><span class="b">{b}</span></span>
    </a>

    <nav class="nav">
      {NAV.map((n) => {
        const active = n.href === '/' ? path === '/' && n.label === 'Home' : path.startsWith(n.href);
        return (
          <div class="nav-item">
            <a href={href(n.href)} class={active ? 'active' : ''}>{n.label}{n.caret && <span class="caret">▾</span>}</a>
            {n.menu && <div class="dropdown">{n.menu.map((m) => <a href={href(m.href)}>{m.label}</a>)}</div>}
          </div>
        );
      })}

      <div class="h-icons">
        <a class="h-icon" href={href('/search')} title="Search" aria-label="search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
        <!--ICONS_SLOT-->
      </div>
    </nav>
  </div>
</header>
<div class="subnav">
  <div class="wrap">
    <a href={href('/whats-new')}>New posts</a>
    <a href={href('/search')}>Search forums</a>
  </div>
</div>
