---
// XenForo-style page numbers: "1 2 3 … 9  Next ▸" (only rendered when there's more than one page).
// url(n) gives the address of page n.
interface Props { current: number; last: number; url: (n: number) => string; }
const { current, last, url } = Astro.props;
// first, last, and two either side of the current page; gaps become "…"
const shown = [...new Set([1, current - 2, current - 1, current, current + 1, current + 2, last])].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
const items: (number | '…')[] = [];
shown.forEach((n, i) => { if (i && n - shown[i - 1] > 1) items.push('…'); items.push(n); });
---
{last > 1 && (
  <nav class="pager" aria-label="Pages">
    {current > 1 && <a class="pager-step" href={url(current - 1)} rel="prev">◂ Prev</a>}
    <span class="pager-nums">
      {items.map((n) => n === '…' ? <span class="pager-gap">…</span>
        : n === current ? <span class="pager-n on" aria-current="page">{n}</span>
        : <a class="pager-n" href={url(n)}>{n}</a>)}
    </span>
    {current < last && <a class="pager-step" href={url(current + 1)} rel="next">Next ▸</a>}
  </nav>
)}
