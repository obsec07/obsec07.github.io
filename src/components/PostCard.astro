---
import { CATEGORY_LABELS } from '../config';
interface Props {
  title: string; slug: string; date: Date; category: string;
  description?: string; tags?: string[];
}
const { title, slug, date, category, description, tags = [] } = Astro.props;
const url = (import.meta.env.BASE_URL.replace(/\/$/, '') + '/posts/' + slug).replace(/\/{2,}/g, '/');
const d = date.toISOString().slice(0, 10);
const label = CATEGORY_LABELS[category] ?? category;
---
<li class="post-item">
  <div class="post-meta">
    <span class="chip">{label}</span>
    <span>{d}</span>
    {tags.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
  </div>
  <h3><a href={url}>{title}</a></h3>
  {description && <p class="desc">{description}</p>}
</li>
