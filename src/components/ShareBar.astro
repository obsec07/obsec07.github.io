---
// Share links (Facebook, Reddit, WhatsApp, email, copy link); each lights up in its brand colour on hover.
interface Props { url: string; title: string; label?: string; }
const { url, title, label } = Astro.props;
const u = encodeURIComponent(url), t = encodeURIComponent(title);
const links = [
  { label: 'Facebook', brand: '#1877f2', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, svg: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>' },
  { label: 'Reddit', brand: '#ff4500', href: `https://www.reddit.com/submit?url=${u}&title=${t}`, svg: '<ellipse cx="12" cy="14.5" rx="8" ry="5.5"/><circle cx="18" cy="5" r="1.6"/><path d="M12 9l1.6-5.2 2.8.8M9.5 17c1.5.9 3.5.9 5 0"/><circle cx="9" cy="13.5" r=".8" fill="currentColor"/><circle cx="15" cy="13.5" r=".8" fill="currentColor"/>' },
  { label: 'WhatsApp', brand: '#25d366', href: `https://api.whatsapp.com/send?text=${t}%20${u}`, svg: '<path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5z"/>' },
  // mailto opens the mail app itself: no new tab (target=_blank would leave an empty one behind)
  { label: 'Email', brand: '#12203a', href: `mailto:?subject=${t}&body=${t}%0A${u}`, svg: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>', self: true },
];
const linkSvg = '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>';
---
<div class="share">
  {label && <span class="share-label">{label}</span>}
  {links.map((s) => (
    <a href={s.href} style={`--brand:${s.brand}`} title={`Share on ${s.label}`} aria-label={`share on ${s.label}`} {...(s.self ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
    </a>
  ))}
  <button type="button" style="--brand:#12203a" data-copy-link={url} title="Copy link" aria-label="copy link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={linkSvg} />
  </button>
</div>
<script is:inline>
  (function () {
    if (window.__shareCopy) return; window.__shareCopy = true;   // one handler, however many share bars
    function toast(msg) {
      var t = document.getElementById('share-toast');
      if (!t) { t = document.createElement('div'); t.id = 'share-toast'; t.className = 'share-toast'; t.setAttribute('role', 'status'); document.body.appendChild(t); }
      t.textContent = msg; t.classList.add('show');
      clearTimeout(t._h); t._h = setTimeout(function () { t.classList.remove('show'); }, 1800);
    }
    // older browsers / no clipboard permission: copy through a hidden text field
    function legacyCopy(text) {
      var ta = document.createElement('textarea'); ta.value = text; ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0'; document.body.appendChild(ta); ta.select();
      var ok = false; try { ok = document.execCommand('copy'); } catch (e) {}
      ta.remove(); return ok;
    }
    window.copyLink = function (text, btn) {
      function done() { toast('Link copied'); if (btn) { btn.classList.add('copied'); setTimeout(function () { btn.classList.remove('copied'); }, 1800); } }
      function fallback() { if (legacyCopy(text)) done(); else window.prompt('Copy this link:', text); }
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, fallback);
      else fallback();
    };
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-copy-link]');
      if (b) window.copyLink(b.getAttribute('data-copy-link') || location.href, b);
    });
  })();
</script>
