---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, STATIC_SITE } from '../config';
import ProfileCard from '../components/ProfileCard.astro';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.handle}` : SITE.title;
const desc = description || SITE.description;
const favicon = "data:image/svg+xml," + encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M10 1.5 C13 2.5 14 6 14 8.5 C14 12 11.5 15 8 15.5 C4.5 15 2 11.5 2 8.5 C2 5.5 4 2.5 7 2 C8 1.7 9 1.3 10 1.5 Z' fill='#6b7078' stroke='#22262b' stroke-width='.8'/><circle cx='6' cy='7' r='1.4' fill='#17191d'/><path d='M11 7.5 C12.4 7.5 13 9 12 10.2 C11 11 9.6 10.4 9.6 9 C9.6 8 10 7.5 11 7.5 Z' fill='#faf6f1'/></svg>"
);
const rssHref = (import.meta.env.BASE_URL.replace(/\/$/, '') + '/rss.xml').replace(/\/{2,}/g, '/');
const whoamiHref = (import.meta.env.BASE_URL.replace(/\/$/, '') + '/whoami').replace(/\/{2,}/g, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#faf6f1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Roboto+Slab:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="icon" href={favicon} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rssHref} />
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
    <div class="cookie" id="cookie" style="display:none">
      <p>This site uses cookies to help personalise content, tailor your experience and to keep you logged in if you register. By continuing to use this site, you are consenting to our use of cookies.</p>
      <div class="btns">
        <button class="b ok" id="cookie-ok">Accept</button>
        <a class="b" href={whoamiHref}>Learn more…</a>
      </div>
    </div>
    <div id="uprofile-host">{STATIC_SITE ? <ProfileCard /> : <Fragment set:html={'<!--UPROFILE-->'} />}</div>
    <script is:inline>
      (function () {
        try {
          if (!localStorage.getItem('cookie-ok')) document.getElementById('cookie').style.display = 'block';
          var ok = document.getElementById('cookie-ok');
          if (ok) ok.addEventListener('click', function () { localStorage.setItem('cookie-ok', '1'); document.getElementById('cookie').style.display = 'none'; });
        } catch (e) {}
      })();
      // dropdown menus: hover opens them with a mouse; a tap or click opens them too (phones have no hover, and
      // Safari doesn't focus a clicked button). On a phone the first tap on "Forums ▾" opens its menu, the second follows the link.
      (function () {
        var items = [].slice.call(document.querySelectorAll('.nav-item')).filter(function (n) { return n.querySelector('.dropdown'); });
        function close(n) { n.classList.remove('open'); var t = n.firstElementChild; if (t) t.setAttribute('aria-expanded', 'false'); }
        items.forEach(function (n) {
          var t = n.firstElementChild; if (!t) return;
          t.setAttribute('aria-expanded', 'false');
          t.addEventListener('click', function (e) {
            var isButton = t.tagName === 'BUTTON', touch = matchMedia('(hover: none)').matches;
            if (!isButton && !(touch && !n.classList.contains('open'))) return;   // mouse, or 2nd tap: follow the link
            e.preventDefault();
            var open = !n.classList.contains('open');
            items.forEach(close);
            if (open) { n.classList.add('open'); t.setAttribute('aria-expanded', 'true'); } else t.blur();
          });
        });
        document.addEventListener('click', function (e) { items.forEach(function (n) { if (!n.contains(e.target)) close(n); }); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') items.forEach(close); });
      })();
      // hover profile card (XenForo-style): shows after a short hover (so sweeping the mouse across the page doesn't
      // flash cards), hides as soon as the mouse leaves (brief grace to move onto the card); click opens the profile
      (function () {
        var host = document.getElementById('uprofile-host'); if (!host) return;
        var showT, hideT;
        function hideAll() { host.querySelectorAll('.uprofile').forEach(function (c) { c.classList.remove('show'); }); }
        var SHOW_MS = 250, HIDE_MS = 100;
        function scheduleHide() { clearTimeout(hideT); hideT = setTimeout(hideAll, HIDE_MS); }
        function place(card, el) {
          var r = el.getBoundingClientRect();
          var vw = document.documentElement.clientWidth, vh = document.documentElement.clientHeight;
          var cw = card.offsetWidth || 330, ch = card.offsetHeight || 180;
          var left = r.left + window.scrollX;
          if (left + cw > window.scrollX + vw - 12) left = window.scrollX + vw - cw - 12;
          card.style.left = Math.max(12, left) + 'px';
          // auto-flip: show above the avatar if there isn't room below (so it never runs off-screen)
          if (vh - r.bottom < ch + 16 && r.top > ch + 16) card.style.top = (r.top + window.scrollY - ch - 8) + 'px';
          else card.style.top = (r.bottom + window.scrollY + 8) + 'px';
          card.classList.add('show');   // CSS handles the smooth fade/scale
        }
        host.querySelectorAll('.uprofile').forEach(function (card) {
          card.addEventListener('mouseenter', function () { clearTimeout(hideT); });
          card.addEventListener('mouseleave', scheduleHide);
        });
        var pending = null;   // the avatar a card is about to open for
        document.querySelectorAll('[data-uprofile]').forEach(function (el) {
          var key = (el.getAttribute('data-uprofile') || '').toLowerCase();
          function schedule() {
            clearTimeout(hideT); clearTimeout(showT); pending = el;
            showT = setTimeout(function () {
              pending = null;
              var card = host.querySelector('.uprofile[data-user="' + key + '"]');
              if (card) { hideAll(); place(card, el); }
            }, SHOW_MS);
          }
          el.addEventListener('mouseenter', schedule);
          // the pointer can already be resting on the avatar (e.g. a scroll closed the card): any small move reopens it
          el.addEventListener('mousemove', function () { if (pending !== el && !host.querySelector('.uprofile.show')) schedule(); });
          el.addEventListener('mouseleave', function () { clearTimeout(showT); pending = null; scheduleHide(); });
          el.style.cursor = 'pointer';
          el.addEventListener('click', function () {
            var card = host.querySelector('.uprofile[data-user="' + key + '"]');
            location.href = (card && card.getAttribute('data-href')) || '/members/' + encodeURIComponent(key);
          });
        });
        // never leave a card hanging: scrolling, switching windows or Esc close it at once
        function hideNow() { clearTimeout(showT); clearTimeout(hideT); pending = null; hideAll(); }
        window.addEventListener('scroll', hideNow, { passive: true });
        window.addEventListener('blur', hideNow);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hideNow(); });
      })();
    </script>
  </body>
</html>
