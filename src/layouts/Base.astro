---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.handle}` : SITE.title;
const desc = description || SITE.description;
const favicon = "data:image/svg+xml," + encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='#faf6f1'/><text x='2' y='12' font-size='11' fill='#22c7d6' font-family='monospace'>0x</text></svg>"
);
const rssHref = (import.meta.env.BASE_URL.replace(/\/$/, '') + '/rss.xml').replace(/\/{2,}/g, '/');
const whoamiHref = (import.meta.env.BASE_URL.replace(/\/$/, '') + '/whoami').replace(/\/{2,}/g, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#faf6f1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Roboto+Slab:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="icon" href={favicon} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rssHref} />
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
    <div class="cookie" id="cookie" style="display:none">
      <p>This site uses cookies to help personalise content, tailor your experience and to keep you logged in if you register. By continuing to use this site, you are consenting to our use of cookies.</p>
      <div class="btns">
        <button class="b ok" id="cookie-ok">Accept</button>
        <a class="b" href={whoamiHref}>Learn more…</a>
      </div>
    </div>
    <div id="uprofile-host"><!--UPROFILE--></div>
    <script is:inline>
      (function () {
        try {
          if (!localStorage.getItem('cookie-ok')) document.getElementById('cookie').style.display = 'block';
          var ok = document.getElementById('cookie-ok');
          if (ok) ok.addEventListener('click', function () { localStorage.setItem('cookie-ok', '1'); document.getElementById('cookie').style.display = 'none'; });
        } catch (e) {}
      })();
      // hover profile card (XenForo-style) — appears after ~3s of hover; click opens the full member page
      (function () {
        var host = document.getElementById('uprofile-host'); if (!host) return;
        var showT, hideT;
        function hideAll() { host.querySelectorAll('.uprofile').forEach(function (c) { c.style.display = 'none'; }); }
        function scheduleHide() { clearTimeout(hideT); hideT = setTimeout(hideAll, 220); }
        function place(card, el) {
          var r = el.getBoundingClientRect(), vw = document.documentElement.clientWidth;
          card.style.display = 'block';
          var cw = card.offsetWidth || 330, left = r.left + window.scrollX;
          if (left + cw > window.scrollX + vw - 12) left = window.scrollX + vw - cw - 12;
          card.style.left = Math.max(12, left) + 'px';
          card.style.top = (r.bottom + window.scrollY + 8) + 'px';
        }
        host.querySelectorAll('.uprofile').forEach(function (card) {
          card.addEventListener('mouseenter', function () { clearTimeout(hideT); });
          card.addEventListener('mouseleave', scheduleHide);
        });
        document.querySelectorAll('[data-uprofile]').forEach(function (el) {
          var key = (el.getAttribute('data-uprofile') || '').toLowerCase();
          el.addEventListener('mouseenter', function () {
            clearTimeout(hideT); clearTimeout(showT);
            showT = setTimeout(function () {
              var card = host.querySelector('.uprofile[data-user="' + key + '"]');
              if (card) { hideAll(); place(card, el); }
            }, 1000);
          });
          el.addEventListener('mouseleave', function () { clearTimeout(showT); scheduleHide(); });
          el.style.cursor = 'pointer';
          el.addEventListener('click', function () { location.href = '/members/' + encodeURIComponent(key); });
        });
      })();
    </script>
  </body>
</html>
