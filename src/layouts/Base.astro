---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, STATIC_SITE, API_URL, avatarUrl, profileUrl } from '../config';
import ProfileCard from '../components/ProfileCard.astro';
// shownPosts: ids of the posts this page already lists; the footer's "Latest posts" skips them (no post twice on a page)
// image: the link-preview picture (a post's first picture; default: your photo); article: a post's dates, blog, tags
interface Props {
  title?: string; description?: string; noindex?: boolean; shownPosts?: string[]; image?: string;
  article?: { published: Date; modified?: Date; section?: string; tags?: string[]; author?: string };
}
const { title, description, noindex = false, shownPosts = [], image, article } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.handle}` : SITE.title;
const desc = description || SITE.description;
// link previews (Discord, WhatsApp, X, LinkedIn…) and search engines: full URLs on the public address
const canonical = new URL(Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\/?$/, '/'), Astro.site).href;
const ownerPhoto = new URL(avatarUrl(SITE.handle), Astro.site).href;
const previewImage = image ? new URL(image, Astro.site).href : ownerPhoto;
const asset = (p: string) => (import.meta.env.BASE_URL.replace(/\/$/, '') + p).replace(/\/{2,}/g, '/');
const rssHref = (import.meta.env.BASE_URL.replace(/\/$/, '') + '/rss.xml').replace(/\/{2,}/g, '/');
const whoamiHref = (import.meta.env.BASE_URL.replace(/\/$/, '') + '/whoami').replace(/\/{2,}/g, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#faf6f1" />
    <script is:inline>
      // light unless the visitor switched to dark (the Dark/Light button); set before anything is drawn, so no flash.
      // The device's dark-mode setting is deliberately ignored: the site always opens light.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name=theme-color]'); if (m) m.content = t === 'dark' ? '#0f131c' : '#faf6f1';
        var c = document.querySelector('meta[name=color-scheme]'); if (c) c.content = t;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title || SITE.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content={image ? title || SITE.title : SITE.handle} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {article && (
      <Fragment>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        {article.section && <meta property="article:section" content={article.section} />}
        {(article.tags ?? []).map((t) => <meta property="article:tag" content={t} />)}
        <meta name="author" content={article.author || SITE.handle} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
          '@context': 'https://schema.org', '@type': 'BlogPosting',
          headline: title, description: desc, url: canonical, mainEntityOfPage: canonical, image: previewImage,
          datePublished: article.published.toISOString(), dateModified: (article.modified || article.published).toISOString(),
          ...(article.section ? { articleSection: article.section } : {}),
          ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
          author: { '@type': 'Person', name: article.author || SITE.handle, url: new URL(profileUrl(SITE.handle), Astro.site).href },
          publisher: { '@type': 'Person', name: SITE.handle, image: ownerPhoto },
        }).replace(/</g, '\\u003c')} />
      </Fragment>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Roboto+Slab:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rssHref} />
  </head>
  <body data-api={API_URL || undefined}>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer exclude={shownPosts} />
    <div class="cookie" id="cookie" style="display:none">
      {API_URL
        ? <p>This site uses a cookie to remember you as a guest (for your likes and replies) and counts visits, including your IP address and approximate location. By continuing to use this site, you are consenting to our use of cookies.</p>
        : <p>This site uses cookies to help personalise content, tailor your experience and to keep you logged in if you register. By continuing to use this site, you are consenting to our use of cookies.</p>}
      <div class="btns">
        <button class="b ok" id="cookie-ok"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Accept</button>
        <a class="b" href={whoamiHref}>Learn more…</a>
      </div>
    </div>
    <button class="to-top" id="to-top" type="button" title="Back to top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 15 12 9 18 15"/></svg>
    </button>
    <div id="uprofile-host">{STATIC_SITE ? <ProfileCard /> : <Fragment set:html={'<!--UPROFILE-->'} />}</div>
    {API_URL && (
      <script is:inline>
        // the guest cookie (a random id: your likes, your replies, unique-visitor counts) and this page view.
        // Visits of the owner, signed in to /admin, aren't counted.
        (function () {
          var api = document.body.getAttribute('data-api'); if (!api) return;
          var m = /(?:^|;\s*)guest=([a-f0-9]{32})/.exec(document.cookie), id = m && m[1];
          if (!id) { var a = new Uint8Array(16); crypto.getRandomValues(a); id = Array.prototype.map.call(a, function (b) { return (b < 16 ? '0' : '') + b.toString(16); }).join(''); }
          document.cookie = 'guest=' + id + '; Max-Age=31536000; Path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
          try { if (sessionStorage.getItem('adm') || localStorage.getItem('adm')) return; } catch (e) {}
          // where the link came from when it says so (?utm_source=instagram, ?ref=linkedin), and the phone model the browser
          // reports (Android Chrome does; iPhones don't), asked for at most 400 ms
          var q = new URLSearchParams(location.search), utm = q.get('utm_source') || q.get('ref') || q.get('source') || '';
          function send(model) {
            var data = JSON.stringify({ path: location.pathname, ref: document.referrer, title: document.title, guest: id, lang: navigator.language, screen: screen.width + 'x' + screen.height, utm: utm, model: model || '', off: -new Date().getTimezoneOffset() });
            try { if (navigator.sendBeacon && navigator.sendBeacon(api + '/hit', data)) return; } catch (e) {}
            fetch(api + '/hit', { method: 'POST', body: data, keepalive: true, headers: { 'Content-Type': 'text/plain' } }).catch(function () {});
          }
          var sent = false, once = function (m) { if (!sent) { sent = true; send(m); } };
          try {
            if (navigator.userAgentData && navigator.userAgentData.getHighEntropyValues) {
              navigator.userAgentData.getHighEntropyValues(['model']).then(function (h) { once(h && h.model); }, function () { once(''); });
              setTimeout(function () { once(''); }, 400);
            } else once('');
          } catch (e) { once(''); }
        })();
        // live numbers: Online statistics (footer), Messages (home page), your Messages and Reaction score (profile)
        (function () {
          var api = document.body.getAttribute('data-api'); if (!api) return;
          var me = null;
          try { me = JSON.parse(sessionStorage.getItem('adm') || localStorage.getItem('adm') || 'null'); } catch (e) {}
          var tok = me && typeof me.token === 'string' ? me.token : '';
          // signed in to /admin and reading the site: Members online counts you (tells the API every 2 minutes at most)
          if (tok) {
            try {
              if (Date.now() - (Number(sessionStorage.getItem('adm-seen')) || 0) > 120000) {
                sessionStorage.setItem('adm-seen', String(Date.now()));
                fetch(api + '/admin/seen', { method: 'POST', headers: { Authorization: 'Bearer ' + tok } }).catch(function () {});
              }
            } catch (e) {}
          }
          function put(sel, f) { document.querySelectorAll(sel).forEach(function (el) { var v = Number(f(el)); if (!isFinite(v)) return; if (window.tobiCount) window.tobiCount(el, v); else el.textContent = v.toLocaleString('en-US'); }); }
          var base = function (el) { return Number(el.getAttribute('data-base')) || 0; };
          fetch(api + '/site-stats').then(function (r) { return r.ok ? r.json() : null; }).then(function (s) {
            if (!s) return;
            var members = s.owner || tok ? 1 : 0;
            put('[data-online=members]', function () { return members; });
            put('[data-online=guests]', function () { return s.online; });
            put('[data-online=total]', function () { return members + s.online; });
            put('[data-fstat=messages]', function (el) { return base(el) + s.replies; });
            put('[data-ostat=messages]', function (el) { return base(el) + s.ownerReplies; });
            put('[data-ostat=reactions]', function (el) { return base(el) + s.likes; });
          }).catch(function () {});
        })();
      </script>
    )}
    <script is:inline>
      // "New" tags end a week after the post, even when the site hasn't been rebuilt since
      (function () {
        document.querySelectorAll('[data-new-until]').forEach(function (el) {
          if (Date.now() < Number(el.getAttribute('data-new-until'))) return;
          if (el.classList.contains('row')) el.classList.remove('unread'); else el.remove();
        });
      })();
      // sections, cards and rows fade up gently as they scroll into view (not for people who turn animation off)
      (function () {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches || /\/admin\/?$/.test(location.pathname)) return;
        var els = document.querySelectorAll('.section, .recent-card, .tl-row, .post-item, .widget, .message, .post-nav, .related, .reply-thread, .pf-stat, .pf-ach, .pf-sec');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('rv-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -6% 0px' });
        els.forEach(function (el, i) { el.classList.add('rv'); el.style.setProperty('--rv-d', (i % 6) * 45 + 'ms'); io.observe(el); });
      })();
      // dynamic touches: decrypting titles, a light that follows the pointer, numbers that count up, pictures that
      // come into focus, # links on headings. Everything stays still for people who turn animation off.
      (function () {
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches, admin = /^\/admin(\/|$)/.test(location.pathname);
        var GLYPHS = '#$%&*+<>/\\=?!01ABCDEFX';
        function glyph() { return GLYPHS[(Math.random() * GLYPHS.length) | 0]; }
        // the title types itself out through a few random characters; the rest of it already holds its place
        function decrypt(el, ms) {
          if (el.children.length || el._scr) return;
          var text = el.textContent, len = text.length; if (!len) return;
          var x = document.createElement('span'), rest = document.createElement('span');
          x.className = 'scr-x'; rest.className = 'scr-rest'; rest.setAttribute('aria-hidden', 'true'); x.setAttribute('aria-hidden', 'true');
          el._scr = 1; el.setAttribute('aria-label', text);
          var done = document.createTextNode(''); el.textContent = ''; el.append(done, x, rest);
          var t0 = performance.now(), last = 0;
          (function step(now) {
            var p = Math.min(1, (now - t0) / ms), n = Math.floor(p * len), w = Math.min(4, len - n);
            done.data = text.slice(0, n); rest.textContent = text.slice(n + w);
            if (now - last > 45) { last = now; x.textContent = text.slice(n, n + w).replace(/\S/g, glyph); }
            if (p < 1) requestAnimationFrame(step);
            else { el.textContent = text; el.removeAttribute('aria-label'); el._scr = 0; }
          })(t0);
        }
        // a short word (the logo) flickers through characters in place
        function flicker(el, ms) {
          if (el._scr) return; var text = el.textContent; el._scr = 1;
          var t0 = performance.now();
          (function step(now) {
            var p = Math.min(1, (now - t0) / ms), n = Math.floor(p * text.length);
            el.textContent = text.slice(0, n) + text.slice(n).replace(/\S/g, glyph);
            if (p < 1) setTimeout(function () { requestAnimationFrame(step); }, 40); else { el.textContent = text; el._scr = 0; }
          })(t0);
        }
        if (!still && !admin) {
          document.querySelectorAll('.thread-head h1, .page-head h1, .pf-nm').forEach(function (h) { decrypt(h, Math.min(900, 280 + h.textContent.length * 16)); });
          var logo = document.querySelector('.logo');
          if (logo) logo.addEventListener('mouseenter', function () { logo.querySelectorAll('.word > span').forEach(function (s) { flicker(s, 420); }); });
          // the light under the pointer on cards and rows
          if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
            document.addEventListener('pointermove', function (e) {
              var c = e.target.closest && e.target.closest('.recent-card, .post-item, .row, .tl-row, .pn, .pf-ach, .pf-proj, .pf-stat'); if (!c) return;
              var r = c.getBoundingClientRect();
              c.style.setProperty('--mx', (e.clientX - r.left) + 'px'); c.style.setProperty('--my', (e.clientY - r.top) + 'px');
            }, { passive: true });
            document.addEventListener('pointerout', function (e) {
              var c = e.target.closest && e.target.closest('.recent-card, .post-item, .row, .tl-row, .pn, .pf-ach, .pf-proj, .pf-stat');
              if (c && !c.contains(e.relatedTarget)) { c.style.removeProperty('--mx'); c.style.removeProperty('--my'); }
            });
          }
        }
        // numbers count up the first time they come into view; the live numbers (online, messages) count to their new value
        var fmt = function (n) { return Math.round(n).toLocaleString('en-US'); };
        var num = function (el) { return Number(el.textContent.replace(/,/g, '')); };
        function run(el, from, to) {
          cancelAnimationFrame(el._cr); el._cw = 'run';
          var t0 = performance.now(), ms = 900;
          (function step(now) {
            var p = Math.min(1, (now - t0) / ms), e = 1 - Math.pow(1 - p, 3);
            el.textContent = fmt(from + (to - from) * e);
            if (p < 1) el._cr = requestAnimationFrame(step); else el._cw = 'done';
          })(t0);
        }
        window.tobiCount = function (el, to) {
          if (!isFinite(to)) return;
          if (still || el._cw !== 'run' && el._cw !== 'done') { el.textContent = fmt(to); return; }   // not shown yet: counts up from 0 to it later
          var from = num(el); if (from !== to) run(el, isFinite(from) ? from : 0, to);
        };
        if (!still && !admin && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return; io.unobserve(e.target);
              var to = num(e.target); if (isFinite(to) && to > 0) run(e.target, 0, to); else e.target._cw = 'done';
            });
          }, { threshold: .6 });
          document.querySelectorAll('.fstats dd, .ac-stats b, .row .stats .n, [data-online], [data-ostat], [data-fstat], .pf-n').forEach(function (el) {
            if (/^\d[\d,]*$/.test(el.textContent.trim())) { el._cw = 'wait'; io.observe(el); }
          });
        }
        // pictures in a post fade in sharp once they've loaded
        if (!still) document.querySelectorAll('.prose img').forEach(function (img) {
          if (img.complete) return;
          img.classList.add('img-wait');
          var show = function () { img.classList.remove('img-wait'); };
          img.addEventListener('load', show); img.addEventListener('error', show); setTimeout(show, 6000);
        });
        // # next to each heading in a post: copies a link straight to that section ("Link copied", from the share bar)
        document.querySelectorAll('.message .prose h2[id], .message .prose h3[id]').forEach(function (h) {
          var a = document.createElement('a');
          a.className = 'h-link'; a.href = '#' + h.id; a.textContent = '#'; a.setAttribute('aria-label', 'Copy link to this section');
          a.addEventListener('click', function (e) {
            e.preventDefault();
            var url = location.href.split('#')[0] + '#' + h.id;
            history.replaceState(null, '', '#' + h.id);
            h.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
            if (window.copyLink) window.copyLink(url);
          });
          h.appendChild(a);
        });
      })();
      (function () {
        try {
          if (!localStorage.getItem('cookie-ok')) document.getElementById('cookie').style.display = 'block';
          var ok = document.getElementById('cookie-ok');
          if (ok) ok.addEventListener('click', function () { localStorage.setItem('cookie-ok', '1'); document.getElementById('cookie').style.display = 'none'; });
        } catch (e) {}
      })();
      // code blocks: a Copy button in each block's title bar (requests, payloads, commands)
      (function () {
        function legacyCopy(text) {
          var ta = document.createElement('textarea'); ta.value = text; ta.setAttribute('readonly', '');
          ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0'; document.body.appendChild(ta); ta.select();
          var ok = false; try { ok = document.execCommand('copy'); } catch (e) {}
          ta.remove(); return ok;
        }
        document.querySelectorAll('.prose pre').forEach(function (pre) {
          var code = pre.querySelector('code'); if (!code) return;
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'code-copy'; b.textContent = 'Copy'; b.setAttribute('aria-label', 'Copy code');
          b.addEventListener('click', function () {
            var text = code.textContent.replace(/\n$/, '');
            function done(ok) {
              if (!ok) window.getSelection().selectAllChildren(code);   // at least select it for Ctrl+C
              b.textContent = ok ? 'Copied!' : 'Press Ctrl+C'; b.classList.toggle('ok', ok);
              clearTimeout(b._t); b._t = setTimeout(function () { b.textContent = 'Copy'; b.classList.remove('ok'); }, 1600);
            }
            if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(legacyCopy(text)); });
            else done(legacyCopy(text));
          });
          pre.appendChild(b);
        });
      })();
      // back to top: shows once you've scrolled a screen or so down
      (function () {
        var t = document.getElementById('to-top'); if (!t) return;
        var queued = false;
        function update() { queued = false; t.classList.toggle('show', scrollY > Math.max(600, innerHeight)); }
        addEventListener('scroll', function () { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        update();
        t.addEventListener('click', function () {
          scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          var h = document.querySelector('.logo'); if (h) h.focus({ preventScroll: true });
        });
      })();
      // dropdown menus: hover opens them with a mouse; a tap or click opens them too (phones have no hover, and
      // Safari doesn't focus a clicked button). On a phone the first tap on "Forums ▾" opens its menu, the second follows the link.
      (function () {
        var items = [].slice.call(document.querySelectorAll('.nav-item')).filter(function (n) { return n.querySelector('.dropdown'); });
        function close(n) { n.classList.remove('open'); var t = n.firstElementChild; if (t) t.setAttribute('aria-expanded', 'false'); }
        items.forEach(function (n) {
          var t = n.firstElementChild; if (!t) return;
          t.setAttribute('aria-expanded', 'false');
          t.addEventListener('click', function (e) {
            var isButton = t.tagName === 'BUTTON', touch = matchMedia('(hover: none)').matches;
            if (!isButton && !(touch && !n.classList.contains('open'))) return;   // mouse, or 2nd tap: follow the link
            e.preventDefault();
            var open = !n.classList.contains('open');
            items.forEach(close);
            if (open) { n.classList.add('open'); t.setAttribute('aria-expanded', 'true'); } else t.blur();
          });
        });
        document.addEventListener('click', function (e) { items.forEach(function (n) { if (!n.contains(e.target)) close(n); }); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') items.forEach(close); });
      })();
      // hover profile card (XenForo-style): shows after a short hover (so sweeping the mouse across the page doesn't
      // flash cards), hides as soon as the mouse leaves (brief grace to move onto the card); click opens the profile
      (function () {
        var host = document.getElementById('uprofile-host'); if (!host) return;
        var showT, hideT;
        function hideAll() { host.querySelectorAll('.uprofile').forEach(function (c) { c.classList.remove('show'); }); }
        var SHOW_MS = 250, HIDE_MS = 100;
        function scheduleHide() { clearTimeout(hideT); hideT = setTimeout(hideAll, HIDE_MS); }
        function place(card, el) {
          var r = el.getBoundingClientRect();
          var vw = document.documentElement.clientWidth, vh = document.documentElement.clientHeight;
          var cw = card.offsetWidth || 330, ch = card.offsetHeight || 180;
          var left = r.left + window.scrollX;
          if (left + cw > window.scrollX + vw - 12) left = window.scrollX + vw - cw - 12;
          card.style.left = Math.max(12, left) + 'px';
          // auto-flip: show above the avatar if there isn't room below (so it never runs off-screen)
          if (vh - r.bottom < ch + 16 && r.top > ch + 16) card.style.top = (r.top + window.scrollY - ch - 8) + 'px';
          else card.style.top = (r.bottom + window.scrollY + 8) + 'px';
          card.classList.add('show');   // CSS handles the smooth fade/scale
        }
        host.querySelectorAll('.uprofile').forEach(function (card) {
          card.addEventListener('mouseenter', function () { clearTimeout(hideT); });
          card.addEventListener('mouseleave', scheduleHide);
        });
        var pending = null;   // the avatar a card is about to open for
        document.querySelectorAll('[data-uprofile]').forEach(function (el) {
          var key = (el.getAttribute('data-uprofile') || '').toLowerCase();
          function schedule() {
            clearTimeout(hideT); clearTimeout(showT); pending = el;
            showT = setTimeout(function () {
              pending = null;
              var card = host.querySelector('.uprofile[data-user="' + key + '"]');
              if (card) { hideAll(); place(card, el); }
            }, SHOW_MS);
          }
          el.addEventListener('mouseenter', schedule);
          // the pointer can already be resting on the avatar (e.g. a scroll closed the card): any small move reopens it
          el.addEventListener('mousemove', function () { if (pending !== el && !host.querySelector('.uprofile.show')) schedule(); });
          el.addEventListener('mouseleave', function () { clearTimeout(showT); pending = null; scheduleHide(); });
          el.style.cursor = 'pointer';
          el.addEventListener('click', function () {
            var card = host.querySelector('.uprofile[data-user="' + key + '"]');
            location.href = (card && card.getAttribute('data-href')) || '/members/' + encodeURIComponent(key);
          });
        });
        // never leave a card hanging: scrolling, switching windows or Esc close it at once
        function hideNow() { clearTimeout(showT); clearTimeout(hideT); pending = null; hideAll(); }
        window.addEventListener('scroll', hideNow, { passive: true });
        window.addEventListener('blur', hideNow);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hideNow(); });
      })();
    </script>
  </body>
</html>
