---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { readingMinutes } from '../lib/posts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="What's new" shownPosts={posts.map((p) => p.id)}>
  <div class="page-head">
    <h1>New posts</h1>
    <p>{posts.length} {posts.length === 1 ? 'entry' : 'entries'} across all sections</p>
  </div>
  {posts.length === 0 ? (
    <div class="empty" style="margin-top:18px">nothing here yet.</div>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <PostCard slug={p.id} title={p.data.title} date={p.data.date} category={p.data.category} description={p.data.description} tags={p.data.tags} minutes={readingMinutes(p.body)} />
      ))}
    </ul>
  )}
</Base>
