---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const indexUrl = (base + '/search-index.json').replace(/\/{2,}/g, '/');
---
<Base title="Search">
  <div class="page-head"><h1>Search</h1><p>Search posts, writeups and tools.</p></div>
  <div class="search-box">
    <input id="q" type="search" placeholder="Type to search…  (title, tag, category)" autocomplete="off" autofocus />
  </div>
  <ul class="posts" id="results"></ul>
  <div class="empty" id="noresults" style="display:none">no results.</div>

  <script is:inline define:vars={{ indexUrl }}>
    (async function () {
      const q = document.getElementById('q');
      const out = document.getElementById('results');
      const none = document.getElementById('noresults');
      let data = [];
      try { data = await (await fetch(indexUrl)).json(); } catch (e) {}
      function esc(s){return (s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
      function render(list) {
        out.innerHTML = list.map(p =>
          '<li class="post-item"><div class="post-meta"><span class="chip">'+esc(p.category)+'</span><span>'+esc(p.date)+'</span>'+
          (p.tags||[]).slice(0,5).map(t=>'<span class="tag">'+esc(t)+'</span>').join('')+
          '</div><h3><a href="'+p.url+'">'+esc(p.title)+'</a></h3>'+
          (p.description?'<p class="desc">'+esc(p.description)+'</p>':'')+'</li>'
        ).join('');
        none.style.display = list.length ? 'none' : 'block';
      }
      function search() {
        const t = q.value.trim().toLowerCase();
        if (!t) { out.innerHTML=''; none.style.display='none'; return; }
        const hits = data.filter(p =>
          (p.title+' '+p.description+' '+p.category+' '+(p.tags||[]).join(' ')).toLowerCase().includes(t));
        render(hits);
      }
      q.addEventListener('input', search);
      const pre = new URLSearchParams(location.search).get('q');
      if (pre) { q.value = pre; search(); }
    })();
  </script>
</Base>
