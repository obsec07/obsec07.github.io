---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';
---
<Base title="Your account">
  <div class="crumbs">⌂ <a href={href('/')}>Home</a> › Your account</div>
  <div class="acct-root"><!--ACCOUNT_SLOT--></div>
</Base>
