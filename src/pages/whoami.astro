---
import Base from '../layouts/Base.astro';
import ShareBar from '../components/ShareBar.astro';
import { SITE, OWNER_PROFILE, SOCIAL_LINKS, avatarUrl, shortUrl } from '../config';
import * as whoamiDoc from '../data/whoami.md';
import { fmtDate } from '../lib/owner';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';
const pageUrl = new URL(href('/whoami'), Astro.site).href;
// the intro is src/data/whoami.md (editable in /admin → Site); {handle} becomes the username
const intro = (await whoamiDoc.compiledContent()).replaceAll('{handle}', SITE.handle);
---
<Base title="Who Am I">
  <article class="whoami">
    <h1>Who Am I</h1>
    <img class="whoami-av" src={avatarUrl(SITE.handle)} alt={SITE.handle} width="170" height="170" />
    <div class="prose">
      <Fragment set:html={intro} />
      {(SITE.email || SOCIAL_LINKS.length > 0) && (
        <Fragment>
          <p>Feel free to connect with me:</p>
          <ul class="connect">
            {SITE.email && <li>Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
            {SOCIAL_LINKS.map((n) => <li>{n.label}: <a href={n.url} rel="me noopener" target="_blank">{shortUrl(n.url)}</a></li>)}
          </ul>
        </Fragment>
      )}
    </div>
    <div class="whoami-meta"><span>Published:</span> {fmtDate(new Date(OWNER_PROFILE.joined))}</div>
    <ShareBar url={pageUrl} title={`Who Am I · ${SITE.handle}`} label="Share:" />
  </article>
</Base>
