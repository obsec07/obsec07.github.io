---
import Base from '../layouts/Base.astro';
import CategoryRow from '../components/CategoryRow.astro';
import ShareBar from '../components/ShareBar.astro';
import { SITE, SECTIONS, CATEGORY_LABELS, STATIC_SITE, avatarUrl, profileAttrs, sectionId } from '../config';
import { getCollection } from 'astro:content';
import { readingMinutes, isLive } from '../lib/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';

const all = (await getCollection('posts', isLive))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

function forCat(key: string) {
  const items = all.filter((p) => p.data.category === key);
  const latest = items[0]
    ? { title: items[0].data.title, url: href('/posts/' + items[0].id), date: fmt(items[0].data.date), author: SITE.handle }
    : null;
  const isNew = items[0] ? (Date.now() - items[0].data.date.valueOf()) / 864e5 < 21 : false;
  return { count: items.length, latest, isNew };
}
// "Recent posts" cards at the top of the forum list: the newest few, one click away; the sidebar lists the next
// ones ("More posts") so no post appears twice, and the footer skips everything already here
const recent = all.slice(0, 3);
const latestPosts = all.slice(3, 8);
const isFresh = (d: Date) => (Date.now() - d.valueOf()) / 864e5 < 21;

// "Share this page" targets the public URL of the home page
const pageUrl = new URL(href('/'), Astro.site).href;
const chevron = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>';
---
<Base shownPosts={[...recent, ...latestPosts].map((p) => p.id)}>
  {SITE.banner && <div class="banner">{SITE.banner}</div>}

  <div class="home-top">
    <button class="icon-btn" id="fs-btn" title="Toggle fullscreen" aria-label="fullscreen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3"/></svg>
    </button>
  </div>
  <div class="home-head">
    <h1 class="forum-title">{SITE.handle}</h1>
    <a class="newposts-btn" href={href('/whats-new')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>
      New posts
    </a>
  </div>

  <div class="home">
    <div class="col">
      {recent.length > 0 && (
        <div class="section recent" id="recent">
          <div class="section-head" role="button" tabindex="0" aria-label="collapse Recent posts">
            <div>
              <h2>Recent posts</h2>
              <span class="sub">The latest writeups, newest first.</span>
            </div>
            <span class="chev" set:html={chevron} />
          </div>
          <div class="rows"><div class="rows-inner">
            <div class="recent-grid">
              {recent.map((p) => (
                <a class="recent-card" href={href('/posts/' + p.id)}>
                  <span class="rc-top">
                    <span class="chip">{CATEGORY_LABELS[p.data.category] ?? p.data.category}</span>
                    {isFresh(p.data.date) && <span class="rc-new">New</span>}
                  </span>
                  <span class="rc-title">{p.data.title}</span>
                  {p.data.description && <span class="rc-desc">{p.data.description}</span>}
                  <span class="rc-meta">{fmt(p.data.date)} · {readingMinutes(p.body)} min read</span>
                </a>
              ))}
            </div>
            <a class="recent-all" href={href('/whats-new')}>All posts →</a>
          </div></div>
        </div>
      )}
      <div id="forums">
      {SECTIONS.map((sec) => (
        <div class="section" id={sectionId(sec.title)}>
          <div class="section-head" role="button" tabindex="0" aria-label={`collapse ${sec.title}`}>
            <div>
              <h2>{sec.title}</h2>
              {sec.subtitle && <span class="sub">{sec.subtitle}</span>}
            </div>
            <span class="chev" set:html={chevron} />
          </div>
          <div class="rows"><div class="rows-inner">
            {sec.items.map((it) => {
              if (it.page) return <CategoryRow title={it.title} desc={it.desc} href={href(it.href!)} page={true} />;
              const s = forCat(it.key);
              return <CategoryRow title={it.title} desc={it.desc} href={href('/' + it.key)} count={s.count} isNew={s.isNew} latest={s.latest} unread={s.isNew} />;
            })}
          </div></div>
        </div>
      ))}
      </div>
    </div>

    <aside class="side">
      {latestPosts.length > 0 && (
      <div class="widget">
        <h3>More posts</h3>
        <ul class="lp">
          {latestPosts.map((p) => (
            <li>
              <img class="av" src={avatarUrl(SITE.handle)} {...profileAttrs(SITE.handle)} alt="" width="22" height="22" loading="lazy" />
              <div>
                <a href={href('/posts/' + p.id)}>{p.data.title}</a>
                <div class="m">{SITE.handle} · {fmt(p.data.date)}</div>
                <div class="m"><a class="cat-link" href={href('/' + p.data.category)}>{CATEGORY_LABELS[p.data.category] ?? p.data.category}</a></div>
              </div>
            </li>
          ))}
        </ul>
      </div>
      )}

      <div class="widget">
        <h3>Forum statistics</h3>
        <dl class="fstats">
          <div><dt>Threads:</dt><dd>{all.length}</dd></div>
          {/* posts + guest replies; the replies are added live from the comments API (Base.astro) */}
          <div><dt>Messages:</dt><dd data-fstat="messages" data-base={all.length}>{all.length}</dd></div>
          {/* on the Node server, members come from the account database */}
          <div><dt>Members:</dt><dd>{STATIC_SITE ? 1 : <Fragment set:html={'<!--STAT_MEMBERS-->'} />}</dd></div>
          <div><dt>Latest member:</dt><dd>{STATIC_SITE ? SITE.handle : <Fragment set:html={'<!--STAT_LATEST-->'} />}</dd></div>
        </dl>
      </div>

      <div class="widget">
        <h3>Share this page</h3>
        <ShareBar url={pageUrl} title={SITE.title} />
      </div>
    </aside>
  </div>

  <script is:inline>
    (function () {
      var b = document.getElementById('fs-btn');
      if (b && !document.fullscreenEnabled) b.hidden = true;   // e.g. iPhone Safari: no page fullscreen
      if (b) b.addEventListener('click', function () {
        if (!document.fullscreenElement) document.documentElement.requestFullscreen && document.documentElement.requestFullscreen();
        else document.exitFullscreen && document.exitFullscreen();
      });
      // collapsible sections (chevron toggles the rows)
      // breadcrumb links land on /#forums or /#blogs: make sure that section is open, and flash it so it's easy to spot
      function openTarget() {
        var t = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (!t) return;
        if (t.classList.contains('section')) t.classList.remove('collapsed');
        t.classList.remove('flash'); void t.offsetWidth; t.classList.add('flash');
      }
      openTarget();
      window.addEventListener('hashchange', openTarget);
      document.querySelectorAll('.section-head').forEach(function (h) {
        function toggle() { h.closest('.section').classList.toggle('collapsed'); }
        h.addEventListener('click', toggle);
        h.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
      });
    })();
  </script>
</Base>
