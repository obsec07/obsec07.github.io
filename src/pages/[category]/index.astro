---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content.config';
import { CATEGORY_LABELS, SITE } from '../../config';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }));
}
const { category } = Astro.params;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const label = CATEGORY_LABELS[category] ?? category;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const av = `/avatar/${encodeURIComponent(SITE.handle)}`;
const subs: Record<string, string> = {
  '0day': "All about my 0day findings & cve's.",
  ctf: 'My CTF writeups for challenges which i considered interesting/enjoyable.',
  infosec: 'InfoSec related Blog.',
  tools: 'tobi tool & research releases.',
};
---
<Base title={label}>
  <nav class="crumbs-box" aria-label="Breadcrumb">
    <a href={href('/')}>⌂ Home</a><span class="sep">›</span><a href={href('/')}>Forums</a><span class="sep">›</span><span class="here">{label}</span>
  </nav>
  <div class="page-head"><h1>{label}</h1>{subs[category] && <p>{subs[category]}</p>}</div>

  <div class="threadlist">
    <div class="tl-head"><span>Threads</span></div>
    {posts.length === 0 ? (
      <div class="tl-empty">No threads here yet.</div>
    ) : posts.map((p) => (
      <div class="tl-row">
        <img class="tl-av" src={av} data-uprofile={SITE.handle} alt="" width="40" height="40" loading="lazy" />
        <div class="tl-main">
          <a class="tl-title" href={href('/posts/' + p.id)}>{p.data.title}</a>
          <div class="tl-sub">{SITE.handle} · {fmt(p.data.date)}</div>
        </div>
        <div class="tl-stats"><Fragment set:html={`<!--THSTATS:${p.id}-->`} /></div>
        <div class="tl-last">
          <div class="tl-last-d">{fmt(p.data.date)}</div>
          <img class="tl-av-sm" src={av} alt="" width="30" height="30" loading="lazy" />
        </div>
      </div>
    ))}
    <div class="tl-foot"><!--POSTHERE--></div>
  </div>
</Base>
