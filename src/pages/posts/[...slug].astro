---
import Base from '../../layouts/Base.astro';
import ShareBar from '../../components/ShareBar.astro';
import Crumbs from '../../components/Crumbs.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts, readingMinutes, neighbours, related, tagHref } from '../../lib/posts';
import { getCollection, render } from 'astro:content';
import { CATEGORY_LABELS, SITE, STATIC_SITE, OWNER_PROFILE, avatarUrl, profileAttrs, profileUrl } from '../../config';
import { ownerStats } from '../../lib/owner';
const owner = STATIC_SITE ? await ownerStats() : null;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body);
// "On this page" box for longer posts (3+ section headings)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const all = await publishedPosts();
const { newer, older } = neighbours(all, post.id);
const similar = related(all.filter((p) => p.id !== newer?.id && p.id !== older?.id), post);   // not the older/newer post again
const onPage = [post.id, newer?.id, older?.id, ...similar.map((p) => p.id)].filter(Boolean) as string[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => (base + p).replace(/\/{2,}/g, '/') || '/';
const label = CATEGORY_LABELS[post.data.category] ?? post.data.category;
const catHref = href('/' + post.data.category);
const postUrl = new URL(href('/posts/' + post.id), Astro.site).href;
const d = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description} shownPosts={onPage}>
  <Crumbs category={post.data.category} />

  <article class="thread">
    <header class="thread-head">
      <h1>{post.data.title}</h1>
      <div class="thread-by">
        <span class="by">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {SITE.handle}
        </span>
        <span class="mid-dot">·</span>
        <span class="by">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {d}
        </span>
        <span class="mid-dot">·</span>
        <span class="by read-time">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2zM22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z"/></svg>
          {minutes} min read
        </span>
      </div>
    </header>

    <div class="message">
      <div class="message-top">
        <span class="msg-date"><span class="live-dot"></span>{d}</span>
        <div class="share-menu">
          <button class="msg-share" type="button" title="Share" aria-label="Share" aria-haspopup="true" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"/></svg>
          </button>
          <div class="share-pop" hidden>
            <div class="share-pop-title">Share this post</div>
            <ShareBar url={postUrl} title={post.data.title} />
            <button class="share-native" type="button" data-url={postUrl} hidden>More options…</button>
          </div>
        </div>
      </div>
      <div class="prose">
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags"><a href={catHref}><span class="chip">{label}</span></a>{post.data.tags.map((t) => <a class="tag" href={tagHref(base, t)}>{t}</a>)}</div>
        )}
        {toc.length >= 3 && (
          <details class="toc" open>
            <summary>On this page</summary>
            <ol>{toc.map((h) => <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}
        <Content />
      </div>
    </div>
    <div class="thread-share"><ShareBar url={postUrl} title={post.data.title} label="Share:" /></div>
    <div class="author-card">
      {owner ? (
        <div class="ac-inner">
          <a href={profileUrl(SITE.handle)}><img class="ac-av" src={avatarUrl(SITE.handle)} {...profileAttrs(SITE.handle)} alt={SITE.handle} /></a>
          <div class="ac-name"><a href={profileUrl(SITE.handle)}>{SITE.handle}</a> <span class="ac-role">{OWNER_PROFILE.role}</span></div>
          <div class="ac-badges"><span class="ac-badge staff">Staff member</span><span class="ac-badge">Member</span></div>
          <div class="ac-stats"><div><span>Messages</span><b>{owner.messages}</b></div><div><span>Reaction score</span><b>{owner.reactions}</b></div><div><span>Points</span><b>{owner.points}</b></div></div>
        </div>
      ) : <Fragment set:html={'<!--AUTHORCARD-->'} />}
    </div>
  </article>

  {(newer || older) && (
    <nav class="post-nav" aria-label="More posts">
      {older ? <a class="pn pn-older" href={href('/posts/' + older.id)}><span class="pn-dir">← Older post</span><span class="pn-title">{older.data.title}</span></a> : <span></span>}
      {newer && <a class="pn pn-newer" href={href('/posts/' + newer.id)}><span class="pn-dir">Newer post →</span><span class="pn-title">{newer.data.title}</span></a>}
    </nav>
  )}

  <div class="read-progress" aria-hidden="true"><span></span></div>

  <script is:inline>
    // reading progress: how far through the post you are, as a thin bar along the top of the window
    (function () {
      var wrap = document.querySelector('.read-progress'), bar = wrap && wrap.firstElementChild, post = document.querySelector('.thread .message');
      if (!bar || !post) return;
      document.body.appendChild(wrap);   // out of <main>: its fade-in animation would otherwise pin the "fixed" bar inside it
      // on a phone the contents box starts folded, so the article isn't pushed below the fold
      var toc = document.querySelector('.toc');
      if (toc && matchMedia('(max-width: 640px)').matches) toc.open = false;
      var queued = false;
      function update() {
        queued = false;
        var r = post.getBoundingClientRect(), total = r.height - innerHeight * 0.6;
        var done = total > 0 ? (innerHeight * 0.4 - r.top) / total : 1;
        bar.style.transform = 'scaleX(' + Math.max(0, Math.min(1, done)) + ')';
      }
      function onScroll() { if (!queued) { queued = true; requestAnimationFrame(update); } }
      addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); update();
    })();
  </script>

  <script is:inline>
    // share icon on the post: a small menu with the share links (+ the system share sheet where there is one)
    (function () {
      var m = document.querySelector('.share-menu'); if (!m) return;
      var btn = m.querySelector('.msg-share'), pop = m.querySelector('.share-pop'), more = m.querySelector('.share-native');
      function set(open) { pop.hidden = !open; btn.setAttribute('aria-expanded', String(open)); }
      btn.addEventListener('click', function () { set(pop.hidden); });
      pop.addEventListener('click', function (e) { if (e.target.closest('a, button')) setTimeout(function () { set(false); }, 0); });
      document.addEventListener('click', function (e) { if (!m.contains(e.target)) set(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !pop.hidden) { set(false); btn.focus(); } });
      if (navigator.share) {
        more.hidden = false;
        more.addEventListener('click', function () { navigator.share({ title: document.title, url: more.getAttribute('data-url') }).catch(function () {}); });
      }
    })();
  </script>

  {!STATIC_SITE && <section class="comments"><Fragment set:html={'<!--COMMENTS_SLOT-->'} /></section>}

  {similar.length > 0 && (
    <section class="related">
      <h2>Related posts</h2>
      <ul class="posts">
        {similar.map((p) => <PostCard slug={p.id} title={p.data.title} date={p.data.date} category={p.data.category} description={p.data.description} tags={p.data.tags} minutes={readingMinutes(p.body)} />)}
      </ul>
    </section>
  )}
</Base>
